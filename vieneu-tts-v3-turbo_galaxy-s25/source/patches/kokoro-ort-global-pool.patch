+int KokoroGlobalIntraOpThreads() {
+  // ORT's first live environment determines its global threading options.
+  static const int threads = [] {
+    const char *setting = std::getenv("KOKORO_ORT_GLOBAL_INTRA_OP");
+    if (!setting || !*setting) {
+      return 0;
+    }
+    const std::string value(setting);
+    size_t parsed = 0;
+    const int width = std::stoi(value, &parsed);
+    if (parsed != value.size() || width < 2) {
+      throw std::invalid_argument("KOKORO_ORT_GLOBAL_INTRA_OP must be >= 2");
+    }
+    return width;
+  }();
+  return threads;
+}
+
+Ort::Env MakeKokoroEnv(const OfflineTtsModelConfig &config) {
+  const int threads = KokoroGlobalIntraOpThreads();
+  if (threads == 0) {
+    return Ort::Env(ORT_LOGGING_LEVEL_ERROR);
+  }
+  if (config.provider != "cpu") {
+    throw std::invalid_argument("Kokoro global ORT pool requires provider cpu");
+  }
+  Ort::ThreadingOptions options;
+  options.SetGlobalIntraOpNumThreads(threads)
+      .SetGlobalInterOpNumThreads(1)
+      .SetGlobalSpinControl(0);
+  return Ort::Env(options, ORT_LOGGING_LEVEL_ERROR, "kokoro-global");
+}
+
+Ort::SessionOptions MakeKokoroSessionOptions(
+    const OfflineTtsModelConfig &config) {
+  auto options = GetSessionOptions(config);
+  if (KokoroGlobalIntraOpThreads() != 0) {
+    options.SetExecutionMode(ORT_SEQUENTIAL).DisablePerSessionThreads();
+  }
+  return options;
+}
+
+}  // namespace
 
