+};
+
+thread_local const BenchSlot* bench_slot = nullptr;
+
+class ScopedBenchSlot {
+public:
+    ScopedBenchSlot(int index, const char* device)
+        : slot_{index, device}, previous_(bench_slot) {
+        bench_slot = &slot_;
+    }
+    ~ScopedBenchSlot() { bench_slot = previous_; }
+
+private:
+    BenchSlot slot_;
+    const BenchSlot* previous_;
+};
