+std::vector<std::string> backbone_devices(int concurrency, int pool_size) {
+    const char *option = std::getenv("VIENEU_BACKBONE_DEVICES");
+    if (!option) {
+        return {};
+    }
+    if (pool_size) {
+        throw std::runtime_error("VIENEU_BACKBONE_DEVICES requires one worker per stream (disable INFERENCEKIT_SENTENCE_WORKERS)");
+    }
+    const char *homogeneous = std::getenv("VIENEU_BACKBONE_DEVICE");
+    if (homogeneous && *homogeneous) {
+        throw std::runtime_error("set only one of VIENEU_BACKBONE_DEVICES and VIENEU_BACKBONE_DEVICE");
+    }
+
+    std::vector<std::string> devices;
+    std::string_view list(option);
+    for (;;) {
+        const auto comma = list.find(',');
+        const auto name = list.substr(0, comma);
+        if (name.empty() || std::any_of(name.begin(), name.end(), [](unsigned char c) {
+                return c <= ' ' || c >= 127;
+            })) {
+            throw std::runtime_error("VIENEU_BACKBONE_DEVICES requires nonempty device names without whitespace");
+        }
+        devices.emplace_back(name);
+        if (comma == std::string_view::npos) {
+            break;
+        }
+        list.remove_prefix(comma + 1);
+    }
+    if (devices.size() != static_cast<size_t>(concurrency)) {
+        throw std::runtime_error("VIENEU_BACKBONE_DEVICES requires exactly one device per stream");
+    }
+    return devices;
+}
