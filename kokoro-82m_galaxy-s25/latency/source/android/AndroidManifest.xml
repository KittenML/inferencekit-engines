<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.kittenml.s25study">
  <uses-sdk android:minSdkVersion="31" android:targetSdkVersion="34" />
  <application android:label="Galaxy S25 TTS study" android:debuggable="true"
      android:extractNativeLibs="true">
    <activity android:name=".StudyActivity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
    <service android:name=".StudyWorker" android:process=":worker" android:exported="false" />
  </application>
</manifest>
