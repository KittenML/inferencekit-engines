+template <typename ConvWeightsT, int Kernel>
+void kokoro_im2col_fixed_rows(ggml_tensor * dst, int ith, int nth, void * userdata) {
+    const auto & conv = *static_cast<const ConvWeightsT *>(userdata);
+    const ggml_tensor * input = dst->src[0];
+    const int64_t begin = dst->ne[1] * ith / nth;
+    const int64_t end = dst->ne[1] * (ith + 1) / nth;
+    auto * out = static_cast<float *>(dst->data);
+    constexpr int64_t kernel = Kernel;
+    for (int64_t frame = begin; frame < end; ++frame) {
+        const int64_t base = frame * conv.stride - conv.padding;
+        const bool interior = base >= 0 && base + (kernel - 1) * conv.dilation < input->ne[0];
+        float * row = out + frame * dst->ne[0];
+        const auto * channel_data = static_cast<const char *>(input->data);
+        for (int64_t channel = 0; channel < conv.in_channels; ++channel) {
+            const auto * src = reinterpret_cast<const float *>(channel_data + channel * input->nb[1]);
+            float * taps = row + channel * kernel;
+            if (interior) {
+                if (conv.dilation == 1) {
+                    std::memcpy(taps, src + base, kernel * sizeof(float));
+                } else {
+                    for (int64_t k = 0; k < kernel; ++k) {
+                        taps[k] = src[base + k * conv.dilation];
+                    }
+                }
+            } else {
+                for (int64_t k = 0; k < kernel; ++k) {
+                    const int64_t index = base + k * conv.dilation;
+                    taps[k] = index >= 0 && index < input->ne[0] ? src[index] : 0.0f;
+                }
+            }
+        }
+    }
+}
+
+template <typename ConvWeightsT>
+auto kokoro_im2col_callback(int64_t kernel, bool specialize) {
+    if (specialize) {
+        switch (kernel) {
+            case 3: return kokoro_im2col_fixed_rows<ConvWeightsT, 3>;
+            case 7: return kokoro_im2col_fixed_rows<ConvWeightsT, 7>;
+            case 11: return kokoro_im2col_fixed_rows<ConvWeightsT, 11>;
+        }
+    }
+    return kokoro_im2col_rows<ConvWeightsT>;
+}
