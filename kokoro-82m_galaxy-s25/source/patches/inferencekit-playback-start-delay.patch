+def test_registered_playback_delay_charges_audible_latency_and_preserves_generation(tmp_path, store):
+    def gaps(rows):
+        for row in rows:
+            if row["stream"] == 0:
+                row["chunks"][1][0] = 650
+                row["complete_ms"] = 700
+            else:
+                row["complete_ms"] = 2050
+        return rows
+
+    args = {**capture(tmp_path, gaps), "first_audio_as_metric": True}
+    immediate = call("import_audio_capacity", args)["data"]["levels"][0]["rounds"][0]
+    plan_path = Path(args["plan"])
+    plan = json.loads(plan_path.read_text())
+    plan["playback_start_delay_ms"] = 80
+    plan_path.write_text(json.dumps(plan))
+
+    delayed = call("import_audio_capacity", args)
+    assert ev.validate(delayed) == []
+    data = delayed["data"]
+    assert data["playback_start_delay_ms"] == 80
+    assert data["n_star"] == 1
+    assert data["levels"][1]["rounds"][0]["wave_overruns"] == 1
+    buffered = data["levels"][0]["rounds"][0]
+    assert immediate["underruns"] == 1
+    assert buffered["underruns"] == 0
+    assert buffered["audio_s_per_s"] == immediate["audio_s_per_s"]
+    assert buffered["streams"][0] == {**immediate["streams"][0], "first_audio_p95_ms": 200, "underruns": 0}
+    trailers = call("ledger_trailers", {"ids": [delayed["evidence_id"]], "format": "json"})
+    assert "80 ms playback start delay" in str(trailers["trailers"])
+
+    plan["playback_start_delay_ms"] = -1
+    plan_path.write_text(json.dumps(plan))
+    with pytest.raises(OpError, match="playback_start_delay_ms"):
+        call("import_audio_capacity", args)
+
+
 def test_rejects_tampered_fixture_and_malformed_failed_row(tmp_path, store):
     args = capture(tmp_path)
