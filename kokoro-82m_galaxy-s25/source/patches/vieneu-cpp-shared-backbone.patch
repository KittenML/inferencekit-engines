+bool env_enabled(const char* name) {
+    const char* value = std::getenv(name);
+    return value && std::strcmp(value, "1") == 0;
+}
+
+bool can_share_cpu_model(const llama_model_params& params) {
+    if (!env_enabled("VIENEU_SHARE_CPU_BACKBONE") || params.n_gpu_layers != 0 || params.devices) {
+        return false;
+    }
+    for (size_t i = 0; i < ggml_backend_dev_count(); ++i) {
+        if (ggml_backend_dev_type(ggml_backend_dev_get(i)) != GGML_BACKEND_DEVICE_TYPE_CPU) {
+            return false;
+        }
+    }
+    return true;
+}
+
+std::shared_ptr<llama_model> load_cpu_model(const std::string& path, const llama_model_params& params) {
+    std::error_code error;
+    const auto key = std::filesystem::canonical(path, error);
+    if (error) {
+        return {llama_model_load_from_file(path.c_str(), params), llama_model_free};
+    }
+
+    // Model files are immutable while in use. Keep no owner beyond the live contexts.
+    static std::mutex mutex;
+    static std::map<std::filesystem::path, std::weak_ptr<llama_model>> models;
+    const std::lock_guard<std::mutex> lock(mutex);
+    for (auto it = models.begin(); it != models.end();) {
+        if (it->second.expired()) {
+            it = models.erase(it);
+        } else {
+            ++it;
+        }
+    }
+    auto& entry = models[key];
+    if (auto model = entry.lock()) {
+        if (env_enabled("VIENEU_BACKBONE_LOG_BUFFERS")) {
+            std::cerr << "[V3NativeBackbone] Reusing CPU backbone model\n";
+        }
+        return model;
+    }
+    std::shared_ptr<llama_model> model(llama_model_load_from_file(path.c_str(), params), llama_model_free);
+    if (model) {
+        entry = model;
+    }
+    return model;
+}
+
 } // namespace
 
